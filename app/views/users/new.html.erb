<h2 class="text-xl font-bold text-gray-900 dark:text-white mb-6">Criar uma conta</h2>

<%= form_with model: @user, class: "space-y-4" do |form| %>
  <% if @user.errors.any? %>
    <div class="p-4 text-sm text-red-800 rounded-lg bg-red-50 border border-red-200 dark:bg-red-800/20 dark:border-red-700 dark:text-red-400">
      <ul class="list-disc list-inside space-y-1">
        <% @user.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :email_address, "E-mail", class: "form-label" %>
    <%= form.email_field :email_address,
          required: true,
          autofocus: true,
          placeholder: "nome@empresa.com",
          class: "form-input" %>
  </div>

  <div>
    <%= form.label :password, "Senha", class: "form-label" %>
    <%= form.password_field :password,
          required: true,
          placeholder: "••••••••",
          class: "form-input" %>
  </div>

  <div>
    <%= form.label :password_confirmation, "Confirmação de Senha", class: "form-label" %>
    <%= form.password_field :password_confirmation,
          required: true,
          placeholder: "••••••••",
          class: "form-input" %>
  </div>

  <%= form.submit "Cadastrar",
        class: "w-full btn-primary cursor-pointer" %>

  <p class="text-sm text-gray-500 dark:text-gray-400 text-center">
    Já tem conta?
    <%= link_to "Entrar", new_session_path, class: "font-medium text-cyan-600 hover:underline dark:text-cyan-500" %>
  </p>
<% end %>
