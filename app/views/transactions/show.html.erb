<% content_for :title, @transaction.title %>

<div class="page-header flex items-center justify-between">
  <div>
    <nav class="flex items-center gap-2 text-sm text-gray-500 mb-2">
      <%= link_to "Lançamentos", transactions_path, class: "hover:text-cyan-600" %>
      <span>/</span>
      <span class="text-gray-900"><%= @transaction.title %></span>
    </nav>
    <h1 class="page-title"><%= @transaction.title %></h1>
  </div>
  <div class="flex items-center gap-3">
    <%= link_to edit_transaction_path(@transaction), class: "btn-secondary flex items-center gap-2" do %>
      <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
        <path d="M13.586 3.586a2 2 0 112.828 2.828l-.793.793-2.828-2.828.793-.793zM11.379 5.793L3 14.172V17h2.828l8.38-8.379-2.83-2.828z"></path>
      </svg>
      Editar
    <% end %>
    <%= button_to transaction_path(@transaction), method: :delete,
          data: { turbo_confirm: "Remover este lançamento?" },
          class: "btn-danger flex items-center gap-2 cursor-pointer" do %>
      <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
        <path fill-rule="evenodd" d="M9 2a1 1 0 00-.894.553L7.382 4H4a1 1 0 000 2v10a2 2 0 002 2h8a2 2 0 002-2V6a1 1 0 100-2h-3.382l-.724-1.447A1 1 0 0011 2H9zM7 8a1 1 0 012 0v6a1 1 0 11-2 0V8zm5-1a1 1 0 00-1 1v6a1 1 0 102 0V8a1 1 0 00-1-1z" clip-rule="evenodd"></path>
      </svg>
      Excluir
    <% end %>
  </div>
</div>

<div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
  <div class="dashboard-card">
    <h3 class="text-lg font-semibold text-gray-900 mb-4">Detalhes do Lançamento</h3>
    <dl class="space-y-4">
      <div class="flex justify-between">
        <dt class="text-sm font-medium text-gray-500">Valor</dt>
        <dd class="text-lg font-bold <%= @transaction.income? ? 'text-green-600' : 'text-red-600' %>">
          <%= @transaction.income? ? "+" : "-" %> <%= number_to_currency(@transaction.amount, unit: "R$ ", separator: ",", delimiter: ".") %>
        </dd>
      </div>
      <div class="flex justify-between border-t pt-2">
        <dt class="text-sm font-medium text-gray-500">Tipo</dt>
        <dd class="text-sm text-gray-900"><%= Transaction::TRANSACTION_TYPE_LABELS[@transaction.transaction_type] %></dd>
      </div>
      <div class="flex justify-between border-t pt-2">
        <dt class="text-sm font-medium text-gray-500">Status</dt>
        <dd class="text-sm text-gray-900">
          <% if @transaction.paid? %>
            <span class="badge-success">Pago</span>
          <% else %>
            <span class="badge-warning">Pendente</span>
          <% end %>
        </dd>
      </div>
      <div class="flex justify-between border-t pt-2">
        <dt class="text-sm font-medium text-gray-500">Data de Vencimento</dt>
        <dd class="text-sm text-gray-900"><%= l(@transaction.due_date, format: :long) if @transaction.due_date %></dd>
      </div>
      <% if @transaction.category.present? %>
        <div class="flex justify-between border-t pt-2">
          <dt class="text-sm font-medium text-gray-500">Categoria</dt>
          <dd class="text-sm text-gray-900"><%= @transaction.category %></dd>
        </div>
      <% end %>
      <% if @transaction.installment.present? && @transaction.total_installments.present? && @transaction.total_installments > 1 %>
        <div class="flex justify-between border-t pt-2">
          <dt class="text-sm font-medium text-gray-500">Parcelamento</dt>
          <dd class="text-sm text-gray-900">Parcela <%= @transaction.installment %> de <%= @transaction.total_installments %></dd>
        </div>
      <% end %>
    </dl>
  </div>

  <div class="dashboard-card">
    <h3 class="text-lg font-semibold text-gray-900 mb-4">Origem / Destino</h3>
    <dl class="space-y-4">
      <% if @transaction.wallet %>
        <div class="flex justify-between">
          <dt class="text-sm font-medium text-gray-500">Carteira</dt>
          <dd class="text-sm text-cyan-600 font-medium"><%= link_to @transaction.wallet.name, wallet_path(@transaction.wallet) %></dd>
        </div>
      <% end %>
      <% if @transaction.credit_card %>
        <div class="flex justify-between <%= 'border-t pt-2' if @transaction.wallet %>">
          <dt class="text-sm font-medium text-gray-500">Cartão de Crédito</dt>
          <dd class="text-sm text-cyan-600 font-medium"><%= link_to @transaction.credit_card.name, credit_card_path(@transaction.credit_card) %></dd>
        </div>
      <% end %>
    </dl>
  </div>
</div>
