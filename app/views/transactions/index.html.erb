<div class="page-header flex items-center justify-between">
  <div>
    <h1 class="page-title">Lançamentos</h1>
    <p class="text-sm text-gray-500">Acompanhe suas receitas e despesas</p>
  </div>
  <%= link_to new_transaction_path, class: "btn-primary flex items-center gap-2" do %>
    <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
      <path fill-rule="evenodd" d="M10 3a1 1 0 011 1v5h5a1 1 0 110 2h-5v5a1 1 0 11-2 0v-5H4a1 1 0 110-2h5V4a1 1 0 011-1z" clip-rule="evenodd"></path>
    </svg>
    Novo Lançamento
  <% end %>
</div>

<div class="mb-6 bg-white p-4 border border-gray-200 rounded-lg shadow-sm">
  <%= form_with url: transactions_path, method: :get, class: "grid grid-cols-1 md:grid-cols-5 gap-4" do |f| %>
    <div>
      <%= f.label :query, "Busca", class: "form-label" %>
      <%= f.text_field :query, value: params[:query], placeholder: "Título...", class: "form-input" %>
    </div>
    <div>
      <%= f.label :type, "Tipo", class: "form-label" %>
      <%= f.select :type, Transaction::TRANSACTION_TYPE_LABELS.map { |k, v| [v, k] }, { include_blank: "Todos", selected: params[:type] }, class: "form-input" %>
    </div>
    <div>
      <%= f.label :status, "Status", class: "form-label" %>
      <%= f.select :status, Transaction::STATUS_LABELS.map { |k, v| [v, k] }, { include_blank: "Todos", selected: params[:status] }, class: "form-input" %>
    </div>
    <div>
      <%= f.label :wallet_id, "Carteira", class: "form-label" %>
      <%= f.select :wallet_id, Current.user.wallets.pluck(:name, :id), { include_blank: "Todas", selected: params[:wallet_id] }, class: "form-input" %>
    </div>
    <div class="flex items-end">
      <%= f.submit "Filtrar", class: "btn-secondary w-full" %>
    </div>
  <% end %>
</div>

<% if @transactions.any? %>
  <div class="dashboard-card">
    <div class="overflow-x-auto">
      <table class="windster-table">
        <thead>
          <tr>
            <th scope="col" class="px-4 py-3">Título / Data</th>
            <th scope="col" class="px-4 py-3">Categoria / Origem</th>
            <th scope="col" class="px-4 py-3">Status</th>
            <th scope="col" class="px-4 py-3 text-right">Valor</th>
            <th scope="col" class="px-4 py-3">
              <span class="sr-only">Ações</span>
            </th>
          </tr>
        </thead>
        <tbody>
          <% @transactions.each do |transaction| %>
            <tr>
              <td class="px-4 py-3">
                <div class="text-sm font-medium text-gray-900">
                  <%= transaction.title %>
                  <% if transaction.installment.present? && transaction.total_installments.present? && transaction.total_installments > 1 %>
                    <span class="text-xs text-gray-500 ml-1">(<%= transaction.installment %>/<%= transaction.total_installments %>)</span>
                  <% end %>
                </div>
                <div class="text-xs text-gray-500"><%= l(transaction.due_date, format: :short) if transaction.due_date %></div>
              </td>
              <td class="px-4 py-3">
                <div class="flex flex-col">
                  <% if transaction.category.present? %>
                    <span class="text-xs font-semibold text-gray-800 mb-1"><%= transaction.category %></span>
                  <% end %>
                  <% if transaction.wallet %>
                    <span class="text-xs text-gray-600 flex items-center gap-1">
                      <svg class="w-3 h-3 text-gray-400" fill="currentColor" viewBox="0 0 20 20"><path d="M4 4a2 2 0 00-2 2v1h16V6a2 2 0 00-2-2H4z"></path><path fill-rule="evenodd" d="M18 9H2v5a2 2 0 002 2h12a2 2 0 002-2V9zM4 13a1 1 0 011-1h1a1 1 0 110 2H5a1 1 0 01-1-1zm5-1a1 1 0 100 2h1a1 1 0 100-2H9z" clip-rule="evenodd"></path></svg>
                      <%= transaction.wallet.name %>
                    </span>
                  <% end %>
                  <% if transaction.credit_card %>
                    <span class="text-xs text-gray-600 flex items-center gap-1">
                      <svg class="w-3 h-3 text-gray-400" fill="currentColor" viewBox="0 0 20 20"><path d="M2 4a2 2 0 012-2h12a2 2 0 012 2v2H2V4z"></path><path fill-rule="evenodd" d="M2 9h16v7a2 2 0 01-2 2H4a2 2 0 01-2-2V9zm4 3a1 1 0 011-1h6a1 1 0 110 2H7a1 1 0 01-1-1z" clip-rule="evenodd"></path></svg>
                      <%= transaction.credit_card.name %>
                    </span>
                  <% end %>
                </div>
              </td>
              <td class="px-4 py-3">
                <% if transaction.paid? %>
                  <span class="badge-success">Pago</span>
                <% else %>
                  <span class="badge-warning">Pendente</span>
                <% end %>
              </td>
              <td class="px-4 py-3 text-right font-semibold <%= transaction.income? ? 'text-green-600' : 'text-red-600' %>">
                <%= transaction.income? ? "+" : "-" %> <%= number_to_currency(transaction.amount, unit: "R$ ", separator: ",", delimiter: ".") %>
              </td>
              <td class="px-4 py-3">
                <div class="flex items-center gap-2 justify-end">
                  <%= link_to edit_transaction_path(transaction), class: "text-gray-500 hover:text-cyan-600" do %>
                    <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                      <path d="M13.586 3.586a2 2 0 112.828 2.828l-.793.793-2.828-2.828.793-.793zM11.379 5.793L3 14.172V17h2.828l8.38-8.379-2.83-2.828z"></path>
                    </svg>
                  <% end %>
                  <%= button_to transaction_path(transaction), method: :delete,
                        data: { turbo_confirm: "Remover este lançamento?" },
                        class: "text-gray-500 hover:text-red-600 cursor-pointer" do %>
                    <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                      <path fill-rule="evenodd" d="M9 2a1 1 0 00-.894.553L7.382 4H4a1 1 0 000 2v10a2 2 0 002 2h8a2 2 0 002-2V6a1 1 0 100-2h-3.382l-.724-1.447A1 1 0 0011 2H9zM7 8a1 1 0 012 0v6a1 1 0 11-2 0V8zm5-1a1 1 0 00-1 1v6a1 1 0 102 0V8a1 1 0 00-1-1z" clip-rule="evenodd"></path>
                    </svg>
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>

<% else %>
  <div class="dashboard-card flex flex-col items-center justify-center py-16 text-center">
    <svg class="w-16 h-16 text-gray-300 mb-4" fill="currentColor" viewBox="0 0 20 20">
      <path d="M2 10a8 8 0 018-8v8h8a8 8 0 11-16 0z"></path>
      <path d="M12 2.252A8.014 8.014 0 0117.748 8H12V2.252z"></path>
    </svg>
    <h3 class="text-lg font-semibold text-gray-900 mb-1">Nenhum lançamento encontrado</h3>
    <p class="text-sm text-gray-500 mb-4">Comece a registrar suas movimentações financeiras.</p>
    <%= link_to "Criar primeiro lançamento", new_transaction_path, class: "btn-primary" %>
  </div>
<% end %>
