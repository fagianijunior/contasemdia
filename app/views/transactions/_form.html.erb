<%= form_with model: transaction, class: "space-y-4" do |form| %>
  <% if transaction.errors.any? %>
    <div class="p-4 text-sm text-red-800 rounded-lg bg-red-50 border border-red-200">
      <ul class="list-disc list-inside space-y-1">
        <% transaction.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :title, "Título", class: "form-label" %>
    <%= form.text_field :title, placeholder: "Ex: Aluguel, Supermercado...", class: "form-input" %>
  </div>

  <div class="grid grid-cols-2 gap-4">
    <div>
      <%= form.label :category, "Categoria", class: "form-label" %>
      <%= form.text_field :category, placeholder: "Ex: Supermercado, Lazer", class: "form-input" %>
    </div>
    
    <div>
      <%= form.label :total_installments, "Parcelar em (x vezes)", class: "form-label" %>
      <%= form.number_field :total_installments, value: transaction.new_record? ? 1 : transaction.total_installments, min: 1, class: "form-input" %>
      <% if !transaction.new_record? && transaction.total_installments.to_i > 1 %>
        <label class="flex items-center gap-2 mt-2 text-sm text-gray-700">
          <%= check_box_tag :split_installments, 1, false, class: "w-4 h-4 text-cyan-600 bg-gray-100 border-gray-300 rounded focus:ring-cyan-500" %>
          Reprocessar/re-dividir essas parcelas
        </label>
      <% end %>
    </div>
  </div>

  <div class="grid grid-cols-2 gap-4">
    <div>
      <%= form.label :amount, "Valor", class: "form-label" %>
      <div class="relative">
        <span class="absolute inset-y-0 left-0 flex items-center pl-3 text-gray-500 text-sm pointer-events-none">R$</span>
        <%= form.text_field :amount,
              placeholder: "0,00",
              class: "form-input pl-9",
              value: transaction.amount.present? ? number_with_precision(transaction.amount, precision: 2, separator: ",") : nil %>
      </div>
    </div>

    <div>
      <%= form.label :transaction_type, "Tipo", class: "form-label" %>
      <%= form.select :transaction_type,
            Transaction::TRANSACTION_TYPE_LABELS.map { |k, v| [v, k] },
            {},
            class: "form-input" %>
    </div>
  </div>

  <div class="grid grid-cols-2 gap-4">
    <div>
      <%= form.label :wallet_id, "Carteira (Opcional)", class: "form-label" %>
      <%= form.collection_select :wallet_id, Current.user.wallets, :id, :name, { include_blank: "Nenhuma" }, class: "form-input" %>
    </div>

    <div>
      <%= form.label :credit_card_id, "Cartão (Opcional)", class: "form-label" %>
      <%= form.collection_select :credit_card_id, Current.user.credit_cards, :id, :name, { include_blank: "Nenhum" }, class: "form-input" %>
    </div>
  </div>

  <div class="grid grid-cols-2 gap-4">
    <div>
      <%= form.label :due_date, "Data de Vencimento", class: "form-label" %>
      <%= form.date_field :due_date, class: "form-input" %>
    </div>

    <div>
      <%= form.label :status, "Status", class: "form-label" %>
      <%= form.select :status,
            Transaction::STATUS_LABELS.map { |k, v| [v, k] },
            {},
            class: "form-input" %>
    </div>
  </div>

  <div class="flex items-center gap-3 pt-2">
    <%= form.submit transaction.new_record? ? "Criar Lançamento" : "Salvar Alterações",
          class: "btn-primary cursor-pointer" %>
    <%= link_to "Cancelar", transactions_path, class: "btn-secondary" %>
  </div>
<% end %>
