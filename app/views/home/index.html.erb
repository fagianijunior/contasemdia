<div class="page-header">
  <h1 class="page-title">Painel</h1>
  <p class="text-sm text-gray-500 dark:text-gray-400">Bem-vindo(a) de volta, <%= Current.user&.email_address %>!</p>
</div>

<!-- Cards de resumo -->
<div class="grid grid-cols-1 gap-4 mb-6 sm:grid-cols-2 xl:grid-cols-3">

  <!-- Card: Total em Carteiras -->
  <div class="dashboard-card flex items-center">
    <div class="inline-flex items-center justify-center flex-shrink-0 w-12 h-12 text-cyan-500 bg-cyan-100 rounded-lg dark:bg-cyan-900 dark:text-cyan-300 mr-4">
      <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
        <path d="M4 4a2 2 0 00-2 2v1h16V6a2 2 0 00-2-2H4z"></path>
        <path fill-rule="evenodd"
          d="M18 9H2v5a2 2 0 002 2h12a2 2 0 002-2V9zM4 13a1 1 0 011-1h1a1 1 0 110 2H5a1 1 0 01-1-1zm5-1a1 1 0 100 2h1a1 1 0 100-2H9z"
          clip-rule="evenodd"></path>
      </svg>
    </div>
    <div>
      <span class="text-2xl font-bold leading-none text-gray-900 dark:text-white sm:text-3xl">
        <%= number_to_currency(@wallets.sum(&:current_balance), unit: "R$ ", separator: ",", delimiter: ".") %>
      </span>
      <h3 class="text-base font-normal text-gray-500 dark:text-gray-400">Saldo total em carteiras</h3>
    </div>
  </div>

  <!-- Card: Carteiras -->
  <div class="dashboard-card flex items-center">
    <div class="inline-flex items-center justify-center flex-shrink-0 w-12 h-12 text-purple-500 bg-purple-100 rounded-lg dark:bg-purple-900 dark:text-purple-300 mr-4">
      <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
        <path d="M5 3a2 2 0 00-2 2v2a2 2 0 002 2h2a2 2 0 002-2V5a2 2 0 00-2-2H5zM5 11a2 2 0 00-2 2v2a2 2 0 002 2h2a2 2 0 002-2v-2a2 2 0 00-2-2H5zM11 5a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V5zM11 13a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z">
        </path>
      </svg>
    </div>
    <div>
      <span class="text-2xl font-bold leading-none text-gray-900 dark:text-white sm:text-3xl">
        <%= @wallets.count %>
      </span>
      <h3 class="text-base font-normal text-gray-500 dark:text-gray-400">Carteiras cadastradas</h3>
    </div>
  </div>

  <!-- Card: Transações recentes -->
  <div class="dashboard-card flex items-center">
    <div class="inline-flex items-center justify-center flex-shrink-0 w-12 h-12 text-green-500 bg-green-100 rounded-lg dark:bg-green-900 dark:text-green-300 mr-4">
      <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
        <path fill-rule="evenodd"
          d="M10 2a4 4 0 00-4 4v1H5a1 1 0 00-.994.89l-1 9A1 1 0 004 18h12a1 1 0 00.994-1.11l-1-9A1 1 0 0015 7h-1V6a4 4 0 00-4-4zm2 5V6a2 2 0 10-4 0v1h4zm-6 3a1 1 0 112 0 1 1 0 01-2 0zm7-1a1 1 0 100 2 1 1 0 000-2z"
          clip-rule="evenodd"></path>
      </svg>
    </div>
    <div>
      <span class="text-2xl font-bold leading-none text-gray-900 dark:text-white sm:text-3xl">
        <%= Current.user.transactions.count %>
      </span>
      <h3 class="text-base font-normal text-gray-500 dark:text-gray-400">Total de lançamentos</h3>
    </div>
  </div>

</div>

<!-- Cartões de crédito -->
<div class="dashboard-card mb-6">
  <div class="flex items-center justify-between mb-4">
    <div>
      <h3 class="text-lg font-semibold text-gray-900 dark:text-white">Cartões de crédito</h3>
      <p class="text-sm text-gray-500 dark:text-gray-400">Acompanhe a fatura atual e os últimos lançamentos.</p>
    </div>
    <%= link_to "Ver todos", credit_cards_path, class: "text-sm font-medium text-cyan-600 hover:underline dark:text-cyan-500" %>
  </div>

  <% if @credit_cards.any? %>
    <div class="grid grid-cols-1 gap-4 md:grid-cols-2 xl:grid-cols-3">
      <% @credit_cards.each do |credit_card| %>
        <% invoice = @credit_card_invoices[credit_card.id] %>
        <% card_transactions = invoice ? invoice[:transactions].select(&:expense?) : [] %>
        <div class="rounded-lg border border-gray-200 p-4 dark:border-gray-700">
          <div class="flex items-start justify-between gap-3">
            <div>
              <p class="font-semibold text-gray-900 dark:text-white"><%= credit_card.name %></p>
              <p class="text-xs text-gray-500 dark:text-gray-400"><%= credit_card.bank&.name || "Cartão de crédito" %></p>
            </div>
            <span class="rounded bg-cyan-100 px-2 py-1 text-xs font-medium text-cyan-800 dark:bg-cyan-900 dark:text-cyan-200"><%= invoice ? (invoice[:month] == Date.current.beginning_of_month ? "Fatura atual" : "Próxima fatura") : "Sem fatura aberta" %></span>
          </div>
          <p class="mt-4 text-2xl font-bold text-gray-900 dark:text-white"><%= number_to_currency(card_transactions.sum(&:amount), unit: "R$ ", separator: ",", delimiter: ".") %></p>
          <p class="text-sm text-gray-500 dark:text-gray-400"><%= pluralize(card_transactions.size, "lançamento", "lançamentos") %></p>
          <%= link_to "Ver detalhes da fatura", credit_card_path(credit_card), class: "mt-4 inline-flex text-sm font-medium text-cyan-600 hover:underline dark:text-cyan-500" %>
        </div>
      <% end %>
    </div>
  <% else %>
    <p class="py-4 text-sm text-gray-500 dark:text-gray-400">Nenhum cartão de crédito cadastrado.</p>
  <% end %>
</div>

<!-- Grid inferior: Últimos lançamentos + Carteiras -->
<div class="grid grid-cols-1 gap-4 xl:grid-cols-3">

  <!-- Tabela de últimos lançamentos (2/3 de largura) -->
  <div class="dashboard-card xl:col-span-2">
    <div class="flex items-center justify-between mb-4">
      <h3 class="text-lg font-semibold text-gray-900 dark:text-white">Últimos Lançamentos</h3>
      <%= link_to "Ver todos", transactions_path, class: "text-sm font-medium text-cyan-600 hover:underline dark:text-cyan-500" %>
    </div>

    <% if @recent_transactions.any? %>
      <div class="overflow-x-auto">
        <table class="windster-table">
          <thead>
            <tr>
              <th scope="col" class="px-4 py-3">Descrição</th>
              <th scope="col" class="px-4 py-3">Vencimento</th>
              <th scope="col" class="px-4 py-3">Valor</th>
              <th scope="col" class="px-4 py-3">Status</th>
            </tr>
          </thead>
          <tbody>
            <% @recent_transactions.each do |transaction| %>
              <tr>
                <td class="px-4 py-3 font-medium text-gray-900 dark:text-white">
                  <%= link_to transaction.title, transaction_path(transaction), class: "hover:text-cyan-600" %>
                </td>
                <td class="px-4 py-3">
                  <%= transaction.due_date&.strftime("%d/%m/%Y") || "—" %>
                </td>
                <td class="px-4 py-3 font-medium <%= transaction.income? ? 'text-green-600' : 'text-red-600' %>">
                  <%= transaction.income? ? "+" : "-" %> <%= number_to_currency(transaction.amount, unit: "R$ ", separator: ",", delimiter: ".") %>
                </td>
                <td class="px-4 py-3">
                  <% if transaction.paid? %>
                    <span class="badge-success">Pago</span>
                  <% else %>
                    <span class="badge-warning">Pendente</span>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="flex flex-col items-center justify-center py-8 text-gray-400 dark:text-gray-500">
        <svg class="w-12 h-12 mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
            d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2">
          </path>
        </svg>
        <p class="text-sm">Nenhum lançamento encontrado.</p>
        <%= link_to "Adicionar lançamento", new_transaction_path, class: "mt-2 text-sm font-medium text-cyan-600 hover:underline" %>
      </div>
    <% end %>
  </div>

  <!-- Painel de carteiras (1/3 de largura) -->
  <div class="dashboard-card">
    <div class="flex items-center justify-between mb-4">
      <h3 class="text-lg font-semibold text-gray-900 dark:text-white">Minhas Carteiras</h3>
      <%= link_to "Ver todas", wallets_path, class: "text-sm font-medium text-cyan-600 hover:underline dark:text-cyan-500" %>
    </div>

    <% if @wallets.any? %>
      <ul class="divide-y divide-gray-200 dark:divide-gray-700">
        <% @wallets.each do |wallet| %>
          <li class="py-3 flex items-center justify-between">
            <div class="flex items-center">
              <div class="flex-shrink-0 w-8 h-8 rounded-full bg-cyan-100 dark:bg-cyan-900 flex items-center justify-center text-cyan-600 dark:text-cyan-300 font-bold text-sm">
                <%= wallet.name&.first&.upcase %>
              </div>
              <div class="ml-3">
                <p class="text-sm font-medium text-gray-900 dark:text-white"><%= wallet.name %></p>
              </div>
            </div>
            <span class="text-sm font-semibold text-gray-900 dark:text-white">
              <%= number_to_currency(wallet.current_balance, unit: "R$ ", separator: ",", delimiter: ".") %>
            </span>
          </li>
        <% end %>
      </ul>
    <% else %>
      <div class="flex flex-col items-center justify-center py-6 text-gray-400 dark:text-gray-500">
        <p class="text-sm">Nenhuma carteira cadastrada.</p>
        <%= link_to "Criar carteira", new_wallet_path, class: "mt-2 text-sm font-medium text-cyan-600 hover:underline" %>
      </div>
    <% end %>

    <div class="mt-4 pt-4 border-t border-gray-200 dark:border-gray-700">
      <%= link_to new_wallet_path, class: "flex items-center text-sm font-medium text-cyan-600 hover:underline dark:text-cyan-500" do %>
        <svg class="w-4 h-4 mr-1" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M10 3a1 1 0 011 1v5h5a1 1 0 110 2h-5v5a1 1 0 11-2 0v-5H4a1 1 0 110-2h5V4a1 1 0 011-1z" clip-rule="evenodd"></path>
        </svg>
        Nova carteira
      <% end %>
    </div>
  </div>

</div>
