<div class="page-header flex items-center justify-between">
  <div>
    <h1 class="page-title">Cartões de Crédito</h1>
    <p class="text-sm text-gray-500">Gerencie seus limites e faturas</p>
  </div>
  <%= link_to new_credit_card_path, class: "btn-primary flex items-center gap-2" do %>
    <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
      <path fill-rule="evenodd" d="M10 3a1 1 0 011 1v5h5a1 1 0 110 2h-5v5a1 1 0 11-2 0v-5H4a1 1 0 110-2h5V4a1 1 0 011-1z" clip-rule="evenodd"></path>
    </svg>
    Novo Cartão
  <% end %>
</div>

<% if @credit_cards.any? %>
  <div class="dashboard-card">
    <div class="overflow-x-auto">
      <table class="windster-table">
        <thead>
          <tr>
            <th scope="col" class="px-4 py-3">Nome</th>
            <th scope="col" class="px-4 py-3">Banco</th>
            <th scope="col" class="px-4 py-3">Limite</th>
            <th scope="col" class="px-4 py-3 text-center">Fechamento / Vencimento</th>
            <th scope="col" class="px-4 py-3">
              <span class="sr-only">Ações</span>
            </th>
          </tr>
        </thead>
        <tbody>
          <% @credit_cards.each do |credit_card| %>
            <tr>
              <td class="px-4 py-3 font-medium text-gray-900">
                <div class="flex items-center gap-3">
                  <div class="flex items-center justify-center w-8 h-8 rounded-lg bg-gray-100 text-gray-700 font-bold text-sm flex-shrink-0">
                    <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                      <path d="M4 4a2 2 0 00-2 2v1h16V6a2 2 0 00-2-2H4z"></path>
                      <path fill-rule="evenodd" d="M18 9H2v5a2 2 0 002 2h12a2 2 0 002-2V9zM4 13a1 1 0 011-1h1a1 1 0 110 2H5a1 1 0 01-1-1zm5-1a1 1 0 100 2h1a1 1 0 100-2H9z" clip-rule="evenodd"></path>
                    </svg>
                  </div>
                  <%= credit_card.name %>
                </div>
              </td>
              <td class="px-4 py-3">
                <%= credit_card.bank %>
              </td>
              <td class="px-4 py-3">
                <%= number_to_currency(credit_card.limit, unit: "R$ ", separator: ",", delimiter: ".") %>
              </td>
              <td class="px-4 py-3 text-center">
                <span class="text-xs font-medium px-2 py-0.5 rounded bg-blue-100 text-blue-800">Dia <%= credit_card.closing_day %></span>
                <span class="mx-1 text-gray-300">/</span>
                <span class="text-xs font-medium px-2 py-0.5 rounded bg-purple-100 text-purple-800">Dia <%= credit_card.due_day %></span>
              </td>
              <td class="px-4 py-3">
                <div class="flex items-center gap-2 justify-end">
                  <%= link_to credit_card_path(credit_card), class: "text-gray-500 hover:text-cyan-600" do %>
                    <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                      <path d="M10 12a2 2 0 100-4 2 2 0 000 4z"></path>
                      <path fill-rule="evenodd" d="M.458 10C1.732 5.943 5.522 3 10 3s8.268 2.943 9.542 7c-1.274 4.057-5.064 7-9.542 7S1.732 14.057.458 10zM14 10a4 4 0 11-8 0 4 4 0 018 0z" clip-rule="evenodd"></path>
                    </svg>
                  <% end %>
                  <%= link_to edit_credit_card_path(credit_card), class: "text-gray-500 hover:text-cyan-600" do %>
                    <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                      <path d="M13.586 3.586a2 2 0 112.828 2.828l-.793.793-2.828-2.828.793-.793zM11.379 5.793L3 14.172V17h2.828l8.38-8.379-2.83-2.828z"></path>
                    </svg>
                  <% end %>
                  <%= button_to credit_card_path(credit_card), method: :delete,
                        data: { turbo_confirm: "Tem certeza que deseja remover \"#{credit_card.name}\"?" },
                        class: "text-gray-500 hover:text-red-600 cursor-pointer" do %>
                    <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                      <path fill-rule="evenodd" d="M9 2a1 1 0 00-.894.553L7.382 4H4a1 1 0 000 2v10a2 2 0 002 2h8a2 2 0 002-2V6a1 1 0 100-2h-3.382l-.724-1.447A1 1 0 0011 2H9zM7 8a1 1 0 012 0v6a1 1 0 11-2 0V8zm5-1a1 1 0 00-1 1v6a1 1 0 102 0V8a1 1 0 00-1-1z" clip-rule="evenodd"></path>
                    </svg>
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>

<% else %>
  <div class="dashboard-card flex flex-col items-center justify-center py-16 text-center">
    <svg class="w-16 h-16 text-gray-300 mb-4" fill="currentColor" viewBox="0 0 20 20">
      <path d="M2 4a2 2 0 012-2h12a2 2 0 012 2v2H2V4z"></path>
      <path fill-rule="evenodd" d="M2 9h16v7a2 2 0 01-2 2H4a2 2 0 01-2-2V9zm4 3a1 1 0 011-1h6a1 1 0 110 2H7a1 1 0 01-1-1z" clip-rule="evenodd"></path>
    </svg>
    <h3 class="text-lg font-semibold text-gray-900 mb-1">Nenhum cartão cadastrado</h3>
    <p class="text-sm text-gray-500 mb-4">Cadastre seus cartões para acompanhar faturas e limites.</p>
    <%= link_to "Cadastrar primeiro cartão", new_credit_card_path, class: "btn-primary" %>
  </div>
<% end %>
