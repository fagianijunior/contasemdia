<div id="<%= dom_id credit_card %>">
  <div>
    <strong>User:</strong>
    <%= credit_card.user_id %>
  </div>

  <div>
    <strong>Name:</strong>
    <%= credit_card.name %>
  </div>
  <div>
    <strong>Bank:</strong>
    <%= credit_card.bank %>
  </div>
  <div>
    <strong>Limit:</strong>
    <%= credit_card.limit %>
  </div>

  <div>
    <strong>Closing day:</strong>
    <%= credit_card.closing_day %>
  </div>

  <div>
    <strong>Due day:</strong>
    <%= credit_card.due_day %>
  </div>

</div>
