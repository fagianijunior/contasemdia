<% content_for :title, @credit_card.name %>

<div class="page-header flex items-center justify-between">
  <div>
    <nav class="flex items-center gap-2 text-sm text-gray-500 mb-2">
      <%= link_to "Cartões", credit_cards_path, class: "hover:text-cyan-600" %>
      <span>/</span>
      <span class="text-gray-900"><%= @credit_card.name %></span>
    </nav>
    <h1 class="page-title"><%= @credit_card.name %></h1>
  </div>
  <div class="flex items-center gap-3">
    <%= link_to edit_credit_card_path(@credit_card), class: "btn-secondary flex items-center gap-2" do %>
      <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
        <path d="M13.586 3.586a2 2 0 112.828 2.828l-.793.793-2.828-2.828.793-.793zM11.379 5.793L3 14.172V17h2.828l8.38-8.379-2.83-2.828z"></path>
      </svg>
      Editar
    <% end %>
    <%= button_to credit_card_path(@credit_card), method: :delete,
          data: { turbo_confirm: "Tem certeza que deseja remover este cartão?" },
          class: "btn-danger flex items-center gap-2 cursor-pointer" do %>
      <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
        <path fill-rule="evenodd" d="M9 2a1 1 0 00-.894.553L7.382 4H4a1 1 0 000 2v10a2 2 0 002 2h8a2 2 0 002-2V6a1 1 0 100-2h-3.382l-.724-1.447A1 1 0 0011 2H9zM7 8a1 1 0 012 0v6a1 1 0 11-2 0V8zm5-1a1 1 0 00-1 1v6a1 1 0 102 0V8a1 1 0 00-1-1z" clip-rule="evenodd"></path>
      </svg>
      Excluir
    <% end %>
  </div>
</div>

<div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
  <div class="dashboard-card">
    <h3 class="text-lg font-semibold text-gray-900 mb-4">Informações do Cartão</h3>
    <dl class="space-y-4">
      <div class="flex justify-between">
        <dt class="text-sm font-medium text-gray-500">Limite Total</dt>
        <dd class="text-sm font-semibold text-gray-900">
          <%= number_to_currency(@credit_card.limit, unit: "R$ ", separator: ",", delimiter: ".") %>
        </dd>
      </div>
      <div class="flex justify-between border-t pt-2">
        <dt class="text-sm font-medium text-gray-500">Dia de Fechamento</dt>
        <dd class="text-sm text-gray-900">Dia <%= @credit_card.closing_day %></dd>
      </div>
      <div class="flex justify-between border-t pt-2">
        <dt class="text-sm font-medium text-gray-500">Dia de Vencimento</dt>
        <dd class="text-sm text-gray-900">Dia <%= @credit_card.due_day %></dd>
      </div>
    </dl>
  </div>

  <div class="dashboard-card md:col-span-2">
    <h3 class="text-lg font-semibold text-gray-900 mb-4">Faturas em aberto</h3>
    <% if @open_invoices.any? %>
      <div class="space-y-6">
        <% @open_invoices.each do |invoice| %>
          <section class="border-t pt-4 first:border-t-0 first:pt-0">
            <div class="flex items-center justify-between mb-3">
              <h4 class="font-semibold text-gray-900"><%= invoice[:month] ? l(invoice[:month], format: "%B de %Y").capitalize : "Sem data" %></h4>
              <span class="font-semibold text-gray-900"><%= number_to_currency(invoice[:transactions].select(&:expense?).sum(&:amount), unit: "R$ ", separator: ",", delimiter: ".") %></span>
            </div>
            <% if invoice[:transactions].any? %>
              <div class="overflow-x-auto">
        <table class="windster-table">
          <thead>
            <tr><th class="px-4 py-3 text-left">Lançamento</th><th class="px-4 py-3 text-left">Vencimento</th><th class="px-4 py-3 text-right">Valor</th></tr>
          </thead>
          <tbody>
            <% invoice[:transactions].each do |transaction| %>
              <tr>
                <td class="px-4 py-3"><%= link_to transaction.title, transaction_path(transaction), class: "hover:text-cyan-600" %></td>
                <td class="px-4 py-3"><%= transaction.due_date&.strftime("%d/%m/%Y") || "—" %></td>
                <td class="px-4 py-3 text-right font-medium text-red-600">- <%= number_to_currency(transaction.amount, unit: "R$ ", separator: ",", delimiter: ".") %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
              </div>
            <% else %>
              <p class="text-sm text-gray-500">Nenhum lançamento nesta fatura.</p>
            <% end %>
          </section>
        <% end %>
      </div>
    <% else %>
      <p class="text-sm text-gray-500">Nenhuma fatura em aberto.</p>
    <% end %>
  </div>
</div>

<div class="dashboard-card">
  <div class="flex items-center justify-between mb-4">
    <h3 class="text-lg font-semibold text-gray-900">Faturas pagas</h3>
    <span class="text-sm text-gray-500"><%= @paid_invoices.size %> competência(s)</span>
  </div>

  <% if @paid_invoices.any? %>
    <div class="space-y-6">
      <% @paid_invoices.each do |invoice| %>
        <section class="border-t pt-4 first:border-t-0 first:pt-0">
          <div class="flex items-center justify-between mb-3">
            <h4 class="font-semibold text-gray-900"><%= invoice[:month] ? l(invoice[:month], format: "%B de %Y").capitalize : "Sem data" %></h4>
            <span class="font-semibold text-gray-900"><%= number_to_currency(invoice[:transactions].select(&:expense?).sum(&:amount), unit: "R$ ", separator: ",", delimiter: ".") %></span>
          </div>
          <% if invoice[:transactions].any? %>
            <div class="overflow-x-auto">
              <table class="windster-table">
                <thead>
                  <tr><th class="px-4 py-3 text-left">Lançamento</th><th class="px-4 py-3 text-left">Vencimento</th><th class="px-4 py-3 text-right">Valor</th></tr>
                </thead>
                <tbody>
                  <% invoice[:transactions].each do |transaction| %>
                    <tr>
                      <td class="px-4 py-3"><%= link_to transaction.title, transaction_path(transaction), class: "hover:text-cyan-600" %></td>
                      <td class="px-4 py-3"><%= transaction.due_date&.strftime("%d/%m/%Y") || "—" %></td>
                      <td class="px-4 py-3 text-right font-medium text-red-600">- <%= number_to_currency(transaction.amount, unit: "R$ ", separator: ",", delimiter: ".") %></td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          <% else %>
            <p class="text-sm text-gray-500">Nenhum lançamento nesta fatura.</p>
          <% end %>
        </section>
      <% end %>
    </div>
  <% else %>
    <p class="text-sm text-gray-500">Nenhuma fatura paga encontrada.</p>
  <% end %>
</div>
