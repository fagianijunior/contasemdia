  <nav class="flex items-center gap-2 text-sm text-gray-500 mb-2">
    <%= link_to "Cartões", credit_cards_path, class: "hover:text-cyan-600" %>
    <span>/</span>
    <%= link_to @credit_card.name, credit_card_path(@credit_card), class: "hover:text-cyan-600" %>
    <span>/</span>
    <span class="text-gray-900">Editar</span>
  </nav>
  <h1 class="page-title">Editar Cartão</h1>
</div>

<div class="dashboard-card max-w-lg">
  <%= render "form", credit_card: @credit_card %>
</div>
