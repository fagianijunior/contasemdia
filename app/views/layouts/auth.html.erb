<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <title><%= content_for(:title) || "ContasemDia" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="Gerencie suas finanças pessoais com facilidade">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-gray-50 dark:bg-gray-900 antialiased font-sans">
    <div class="flex flex-col items-center justify-center min-h-screen px-4 py-8">

      <!-- Logo -->
      <div class="mb-8 text-center">
        <%= link_to root_path, class: "flex items-center justify-center mb-2" do %>
          <span class="text-3xl font-bold">
            <span class="text-cyan-600">Contas</span><span class="text-gray-900 dark:text-white">em</span><span class="text-cyan-600">Dia</span>
          </span>
        <% end %>
        <p class="text-sm text-gray-500 dark:text-gray-400">Gerencie suas finanças com facilidade</p>
      </div>

      <!-- Flash messages -->
      <% if notice.present? %>
        <div class="w-full max-w-md p-4 mb-4 text-sm text-green-800 rounded-lg bg-green-50 border border-green-200 dark:bg-green-800/20 dark:border-green-700 dark:text-green-400" role="alert">
          <%= notice %>
        </div>
      <% end %>
      <% if alert.present? %>
        <div class="w-full max-w-md p-4 mb-4 text-sm text-red-800 rounded-lg bg-red-50 border border-red-200 dark:bg-red-800/20 dark:border-red-700 dark:text-red-400" role="alert">
          <%= alert %>
        </div>
      <% end %>

      <!-- Card do formulário -->
      <div class="w-full max-w-md bg-white rounded-lg shadow dark:bg-gray-800 dark:border dark:border-gray-700">
        <div class="p-6 sm:p-8">
          <%= yield %>
        </div>
      </div>

    </div>
  </body>
</html>
