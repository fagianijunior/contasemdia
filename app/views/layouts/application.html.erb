<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <title><%= content_for(:title) || "ContasemDia" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="Gerencie suas finanças pessoais com facilidade">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-gray-50 antialiased font-sans">
    <% if authenticated? %>
      <%= render "layouts/topbar" %>
      <%= render "layouts/sidebar" %>

      <!-- pt-16 compensa a topbar fixa de h-16, lg:ml-64 compensa a sidebar -->
      <div class="pt-16 lg:ml-64 min-h-screen bg-gray-50">

        <!-- Flash messages -->
        <div class="px-4 pt-4">
          <% if notice.present? %>
            <div class="p-4 mb-4 text-sm text-green-800 rounded-lg bg-green-50 border border-green-200" role="alert">
              <%= notice %>
            </div>
          <% end %>
          <% if alert.present? %>
            <div class="p-4 mb-4 text-sm text-red-800 rounded-lg bg-red-50 border border-red-200" role="alert">
              <%= alert %>
            </div>
          <% end %>
        </div>

        <!-- Conteúdo principal -->
        <main class="px-4 pb-12">
          <%= yield %>
        </main>

        <!-- Footer -->
        <footer class="p-4 my-6 mx-4 bg-white rounded-lg border border-gray-200 shadow-sm">
          <span class="text-sm text-gray-500">
            © <%= Date.current.year %> <span class="font-semibold text-cyan-600">ContasemDia</span>. Todos os direitos reservados.
          </span>
        </footer>

      </div>

    <% else %>
      <!-- Layout simples para páginas não autenticadas -->
      <div class="min-h-screen flex flex-col">
        <% if notice.present? %>
          <div class="p-4 text-sm text-green-800 bg-green-50 border-b border-green-200" role="alert">
            <div class="max-w-md mx-auto"><%= notice %></div>
          </div>
        <% end %>
        <% if alert.present? %>
          <div class="p-4 text-sm text-red-800 bg-red-50 border-b border-red-200" role="alert">
            <div class="max-w-md mx-auto"><%= alert %></div>
          </div>
        <% end %>
        <main class="flex-1">
          <%= yield %>
        </main>
      </div>
    <% end %>

    <!-- Toggle sidebar mobile -->
    <script>
      const toggleBtn = document.getElementById('toggleSidebarMobile');
      const sidebar = document.getElementById('sidebar');
      const backdrop = document.getElementById('sidebarBackdrop');
      const hamburger = document.getElementById('toggleSidebarMobileHamburger');
      const closeIcon = document.getElementById('toggleSidebarMobileClose');

      if (toggleBtn) {
        toggleBtn.addEventListener('click', function () {
          sidebar.classList.toggle('hidden');
          backdrop.classList.toggle('hidden');
          hamburger.classList.toggle('hidden');
          closeIcon.classList.toggle('hidden');
        });
        backdrop.addEventListener('click', function () {
          sidebar.classList.add('hidden');
          backdrop.classList.add('hidden');
          hamburger.classList.remove('hidden');
          closeIcon.classList.add('hidden');
        });
      }
    </script>
  </body>
</html>
