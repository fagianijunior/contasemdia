<aside id="sidebar"
  class="fixed top-0 left-0 z-20 flex flex-col flex-shrink-0 hidden w-64 h-full pt-16 font-normal lg:flex"
  aria-label="Sidebar">
  <div class="relative flex flex-col flex-1 min-h-0 bg-white border-r border-gray-200">
    <div class="flex flex-col flex-1 pt-5 pb-4 overflow-y-auto">
      <div class="flex-1 px-3 space-y-1 bg-white divide-y divide-gray-200">

        <!-- Menu principal -->
        <ul class="pb-2 space-y-2">
          <li>
            <%= link_to root_path, class: "sidebar-link group #{current_page?(root_path) ? 'sidebar-link-active' : ''}" do %>
              <svg class="sidebar-icon" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
                <path d="M2 10a8 8 0 018-8v8h8a8 8 0 11-16 0z"></path>
                <path d="M12 2.252A8.014 8.014 0 0117.748 8H12V2.252z"></path>
              </svg>
              <span class="ml-3">Painel</span>
            <% end %>
          </li>

          <li>
            <%= link_to transactions_path, class: "sidebar-link group #{request.path.start_with?('/transactions') ? 'sidebar-link-active' : ''}" do %>
              <svg class="sidebar-icon" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
                <path fill-rule="evenodd"
                  d="M10 2a4 4 0 00-4 4v1H5a1 1 0 00-.994.89l-1 9A1 1 0 004 18h12a1 1 0 00.994-1.11l-1-9A1 1 0 0015 7h-1V6a4 4 0 00-4-4zm2 5V6a2 2 0 10-4 0v1h4zm-6 3a1 1 0 112 0 1 1 0 01-2 0zm7-1a1 1 0 100 2 1 1 0 000-2z"
                  clip-rule="evenodd"></path>
              </svg>
              <span class="flex-1 ml-3 whitespace-nowrap">Lançamentos</span>
            <% end %>
          </li>

          <li>
            <%= link_to wallets_path, class: "sidebar-link group #{request.path.start_with?('/wallets') ? 'sidebar-link-active' : ''}" do %>
              <svg class="sidebar-icon" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
                <path d="M4 4a2 2 0 00-2 2v1h16V6a2 2 0 00-2-2H4z"></path>
                <path fill-rule="evenodd"
                  d="M18 9H2v5a2 2 0 002 2h12a2 2 0 002-2V9zM4 13a1 1 0 011-1h1a1 1 0 110 2H5a1 1 0 01-1-1zm5-1a1 1 0 100 2h1a1 1 0 100-2H9z"
                  clip-rule="evenodd"></path>
              </svg>
              <span class="flex-1 ml-3 whitespace-nowrap">Carteiras</span>
            <% end %>
          </li>

          <li>
            <%= link_to credit_cards_path, class: "sidebar-link group #{request.path.start_with?('/credit_cards') ? 'sidebar-link-active' : ''}" do %>
              <svg class="sidebar-icon" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
                <path d="M2 4a2 2 0 012-2h12a2 2 0 012 2v2H2V4z"></path>
                <path fill-rule="evenodd"
                  d="M2 9h16v7a2 2 0 01-2 2H4a2 2 0 01-2-2V9zm4 3a1 1 0 011-1h6a1 1 0 110 2H7a1 1 0 01-1-1z"
                  clip-rule="evenodd"></path>
              </svg>
              <span class="flex-1 ml-3 whitespace-nowrap">Cartões de Crédito</span>
            <% end %>
          </li>
        </ul>

        <!-- Seção inferior -->
        <div class="pt-2 space-y-2">
          <% if authenticated? %>
            <%= button_to session_path, method: :delete,
                  class: "sidebar-link group w-full cursor-pointer" do %>
              <svg class="sidebar-icon" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
                <path fill-rule="evenodd"
                  d="M3 3a1 1 0 00-1 1v12a1 1 0 102 0V4a1 1 0 00-1-1zm10.293 9.293a1 1 0 001.414 1.414l3-3a1 1 0 000-1.414l-3-3a1 1 0 10-1.414 1.414L14.586 9H7a1 1 0 100 2h7.586l-1.293 1.293z"
                  clip-rule="evenodd"></path>
              </svg>
              <span class="flex-1 ml-3 whitespace-nowrap text-left">Sair</span>
            <% end %>
          <% end %>
        </div>

      </div>
    </div>
  </div>
</aside>

<!-- Overlay para mobile -->
<div class="fixed inset-0 z-10 hidden bg-gray-900/50" id="sidebarBackdrop"></div>
